# Copiar a /etc/soweb.env, completar, y restringir permisos:
#   sudo cp deploy/soweb.env.example /etc/soweb.env
#   sudo chown root:soweb /etc/soweb.env && sudo chmod 640 /etc/soweb.env
#
# Este archivo contiene secretos: nunca va al repositorio.

# --- Datos persistentes -----------------------------------------------------
# Fuera del directorio del código, para que un despliegue nunca los pise.
SOWEB_DB_PATH=/var/lib/soweb/soweb.db
SOWEB_STORAGE_DIR=/var/lib/soweb/storage

# --- Clave de cifrado -------------------------------------------------------
# Cifra las contraseñas de correo guardadas en mailSO.
# ¡Guardá una copia! Si se pierde, esas contraseñas quedan ilegibles y hay que
# volver a cargarlas (no se pierde correo: vive en el servidor del proveedor).
# Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOWEB_SECRET_KEY=

# --- Quién puede registrarse ------------------------------------------------
# Con un valor acá, crear cuenta exige ese código. Vacío = registro abierto.
SOWEB_INVITE_CODE=

# --- CORS -------------------------------------------------------------------
# Vacío con la configuración de nginx recomendada: el frontend se sirve desde
# el mismo origen, así que no hay petición entre orígenes que permitir.
SOWEB_CORS_ORIGINS=

# --- Límite de intentos de login --------------------------------------------
SOWEB_LOGIN_MAX_ATTEMPTS=8
SOWEB_LOGIN_LOCKOUT_SECONDS=300
